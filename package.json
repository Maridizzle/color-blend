{
  "name": "color-blend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An art-reveal game played through color-sorting puzzles.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "COLOR_BLEND_STANDALONE=1 npm run build && node tools/standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack": "tsx tools/pack-cli.ts",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
